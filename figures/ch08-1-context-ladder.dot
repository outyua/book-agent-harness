// 图 8-1 上下文管理的四个处理级别：成本依次增加
// 生成: dot -Tsvg ch08-1-context-ladder.dot -o ch08-1-context-ladder.svg
digraph ladder {
  rankdir=TB;
  ranksep=0.30;
  nodesep=0.24;
  bgcolor="white";
  node [fontname="Helvetica,Arial,sans-serif", fontsize=10, shape=box, style="filled", fillcolor="white", color="#333333", width=6.0];
  edge [fontname="Helvetica,Arial,sans-serif", fontsize=9, color="#333333"];
  graph [fontname="Helvetica,Arial,sans-serif", fontsize=11];

  l1 [label="① 裁剪 prune　　　确定性 · 无模型调用 · 有损但可预测\l　　 清空旧工具输出的正文，保留调用记录本身\l　　 opencode: 跳过最近 2 轮，保护最新 40K token 的工具输出\l", fillcolor="#f6f6f6"];

  l2 [label="② 摘要压缩 compaction　需模型调用 · 有损 · 不可逆\l　　 只摘要上一个压缩边界之后的历史（防摘要自我膨胀）\l　　 切点不落在 toolResult 上；摘要请求隔离缓存\l", fillcolor="#eeeeee"];

  l3 [label="③ checkpoint 重建　　结构化状态替代原始历史\l　　 不删库，只插边界；下一轮只读边界之后\l　　 重建材料：checkpoint + memory + 任务清单 + 最近用户输入\l", fillcolor="#e6e6e6"];

  l4 [label="④ 按需召回 history　　原始记录仍在，定点取回\l　　 FTS/BM25 搜索 → message id → around 取邻近原文\l　　 单次结果仍限额（如 20 KiB），防「恢复细节」再撑爆\l", fillcolor="#dedede"];

  l1 -> l2 [label="仍然超限"];
  l2 -> l3 [label="有 checkpoint 可用时优先跳到 ③"];
  l3 -> l4 [label="模型发现细节缺失时", style=dashed];

  note [label="第 6 章的耦合：每一级都改写历史 = 一次缓存失效。所以「什么时候做」和「做什么」同样重要。",
        shape=note, fillcolor="white", fontsize=10, width=6.0];
  l4 -> note [style=invis];
}
